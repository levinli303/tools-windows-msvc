+#if defined(_WIN32)
+// Ensure we free the Fls index during DLL_PROCESS_DETACH so the OS won't
+// attempt to call back into this DLL after it has been unloaded.  This
+// prevents crashes when the Fls cleanup callback points into the DLL.
+extern "C" BOOL WINAPI DllMain(HINSTANCE hinst, DWORD reason, LPVOID reserved)
+{
+	switch (reason)
+	{
+    // When threads exit (DLL_THREAD_DETACH) or the process is detaching
+    // (DLL_PROCESS_DETACH), run our cleanup for the current thread while
+    // the DLL is still loaded.  We avoid registering an FLS callback and
+    // instead perform the cleanup here to guarantee the code is present.
+	case DLL_THREAD_DETACH:
+	case DLL_PROCESS_DETACH:
+		if (ARCThreadKey != (arc_tls_key_t)TLS_OUT_OF_INDEXES)
+		{
+			void *val = TlsGetValue(ARCThreadKey);
+			if (val)
+			{
+				// Clear the slot and run our cleanup on the thread's data.
+				TlsSetValue(ARCThreadKey, NULL);
+				cleanupPools(static_cast<struct arc_tls*>(val));
+			}
+		}
+		if (reason == DLL_PROCESS_DETACH)
+		{
+			if (ARCThreadKey != (arc_tls_key_t)TLS_OUT_OF_INDEXES)
+			{
+				TlsFree(ARCThreadKey);
+				ARCThreadKey = (arc_tls_key_t)TLS_OUT_OF_INDEXES;
+			}
+		}
+		break;
+	default:
+		break;
+	}
+	return TRUE;
+}
+#endif
